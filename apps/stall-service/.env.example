# loopback (default) or lan
POLIVO_LISTEN_MODE=loopback
HOST=127.0.0.1
PORT=3040
# Absolute path outside the repository. Create with:
#   $env:POLIVO_LOCAL_DB_PATH="C:\path\to\polivo-dev.sqlite"; pnpm --filter @polivo/db-local db:init
POLIVO_LOCAL_DB_PATH=
# Optional overrides (both required together); otherwise TLS is auto-managed under POLIVO_HOST_CREDENTIAL_ROOT
# POLIVO_HOST_CREDENTIAL_ROOT=
# POLIVO_TLS_KEY_PATH=
# POLIVO_TLS_CERT_PATH=
