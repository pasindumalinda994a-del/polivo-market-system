# Clerk (development). Replace placeholders with your Clerk Dashboard values.
# NEXT_PUBLIC_* values are exposed to the browser.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=your_clerk_development_publishable_key
# Server-only. Do not prefix with NEXT_PUBLIC_.
CLERK_SECRET_KEY=your_clerk_development_secret_key

# Supabase (development). Replace placeholders with your Supabase project values.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your_supabase_development_publishable_key
# Server-only. Privileged secret / service role. Do not prefix with NEXT_PUBLIC_.
SUPABASE_SECRET_KEY=your_supabase_development_secret_key
# Server-only Postgres connection string for schema/migrations. Do not prefix with NEXT_PUBLIC_.
DATABASE_URL=postgresql://postgres:your_password@db.your-project-ref.supabase.co:5432/postgres
