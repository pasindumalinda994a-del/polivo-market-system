{
  "name": "polivo-market-system",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.16.1",
  "engines": {
    "node": ">=26.13.0 <27"
  },
  "scripts": {
    "doctor": "node scripts/check-dev-environment.mjs",
    "dev:contracts": "pnpm --filter @polivo/contracts dev",
    "dev:web": "pnpm --filter @polivo/web dev",
    "dev:desktop": "pnpm --filter @polivo/desktop dev",
    "dev:service": "pnpm --filter @polivo/stall-service dev",
    "build": "pnpm --filter @polivo/contracts build && pnpm --filter @polivo/web build && pnpm --filter @polivo/desktop build && pnpm --filter @polivo/stall-service build",
    "typecheck": "pnpm --filter @polivo/contracts typecheck && pnpm --filter @polivo/web typecheck && pnpm --filter @polivo/desktop typecheck && pnpm --filter @polivo/stall-service typecheck",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test:unit": "vitest run --project contracts",
    "test:integration": "vitest run --project integration",
    "test": "vitest run --project contracts --project integration",
    "test:watch": "vitest --project contracts --project integration",
    "test:coverage": "vitest run --project contracts --project integration --coverage",
    "test:e2e:web": "pnpm --filter @polivo/web build && playwright test --config=tests/e2e/web/playwright.config.ts",
    "test:e2e:desktop": "pnpm --filter @polivo/desktop build && playwright test --config=tests/e2e/desktop/playwright.config.ts",
    "check": "pnpm run doctor && pnpm run lint && pnpm run format:check && pnpm run typecheck && pnpm test"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.64.1",
    "@vitest/coverage-v8": "5.0.5",
    "eslint": "10.13.0",
    "eslint-config-next": "16.4.3",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-react": "7.37.5",
    "eslint-plugin-react-hooks": "7.0.1",
    "globals": "17.13.0",
    "prettier": "3.9.10",
    "typescript": "5.9.3",
    "typescript-eslint": "8.72.1",
    "vitest": "5.0.5"
  }
}
