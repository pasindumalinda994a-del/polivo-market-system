{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022"],
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "types": ["node"],
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "declaration": false,
    "declarationMap": false,
    "paths": {
      "@polivo/contracts": ["./packages/contracts/src/index.ts"],
      "@polivo/db-local": ["./packages/db-local/src/index.ts"],
      "@polivo/db-cloud": ["./packages/db-cloud/src/index.ts"]
    }
  },
  "include": [
    "packages/contracts/src/**/*.ts",
    "packages/db-local/src/**/*.ts",
    "packages/db-cloud/src/**/*.ts",
    "tests/integration/**/*.ts",
    "apps/stall-service/src/**/*.ts"
  ],
  "exclude": ["**/dist/**", "**/node_modules/**", "tests/e2e/**"]
}
